eo/episode_0_1791646787.png", "duration_seconds": 10.24, "width": 640, "height": 360}], "trajectory_svg": "cases/random_locomotion/config-0001/world-xy.svg", "trajectory_csv": "cases/random_locomotion/config-0001/attempt-0001/trajectory.csv", "result_json": "cases/random_locomotion/config-0001/attempt-0001/result.json", "case_evidence": "cases/random_locomotion/config-0001/attempt-0001/case-evidence.json", "attempts_json": "cases/random_locomotion/config-0001/attempts.json", "attempts": [{"number": 1, "status": "completed", "returncode": 0, "files": ["cases/random_locomotion/config-0001/attempt-0001/control-ack.json", "cases/random_locomotion/config-0001/attempt-0001/inference-process-start.json", "cases/random_locomotion/config-0001/attempt-0001/inference.json", "cases/random_locomotion/config-0001/attempt-0001/inference.log", "cases/random_locomotion/config-0001/attempt-0001/policy-ready.json", "cases/random_locomotion/config-0001/attempt-0001/policy-recording/rollout_duration6.0s_motion.npz", "cases/random_locomotion/config-0001/attempt-0001/released.json", "cases/random_locomotion/config-0001/attempt-0001/result.json", "cases/random_locomotion/config-0001/attempt-0001/run.json", "cases/random_locomotion/config-0001/attempt-0001/sim-clock.json", "cases/random_locomotion/config-0001/attempt-0001/sim-ready.json", "cases/random_locomotion/config-0001/attempt-0001/simulation.json", "cases/random_locomotion/config-0001/attempt-0001/simulator-process-start.json", "cases/random_locomotion/config-0001/attempt-0001/simulator.log", "cases/random_locomotion/config-0001/attempt-0001/stop", "cases/random_locomotion/config-0001/attempt-0001/trajectory.csv", "cases/random_locomotion/config-0001/attempt-0001/video/episode_0_1791646787.mp4", "cases/random_locomotion/config-0001/attempt-0001/video/episode_0_1791646787.png", "cases/random_locomotion/config-0001/attempt-0001/worker-processes.json", "cases/random_locomotion/config-0001/attempt-0001/case-evidence.json"], "parent_log": "cases/random_locomotion/config-0001/attempt-0001/parent-execution.log", "original_receipt": {"number": 1, "output": "/outputs/reference629/random_locomotion/config-0001-cfg0001_stand_2.0s_run_left_45_2.0s_stand_2.0s-81228c5c24f8", "launch": ["/opt/php/envs/inference/bin/python", "/workspace/php_parkour/scripts/research/sim2sim.py", "--models", "/data/assets/student", "--terrain", "custom", "--mesh", "/workspace/php_parkour/outputs/research/motion-matching/scenarios/random_locomotion/cfg0001_stand_2.0s_run_left_45_2.0s_stand_2.0s_terrain.obj", "--reference-motion", "/workspace/php_parkour/outputs/research/motion-matching/scenarios/random_locomotion/cfg0001_stand_2.0s_run_left_45_2.0s_stand_2.0s_motion.npz", "--reference-spawn", "--record-policy", "--seed", "42", "--gl", "egl", "--python-faulthandler", "--sim-python", "/opt/php/bin/train-python", "--inference-python", "/opt/php/bin/inference-python", "--output", "/outputs/reference629/random_locomotion/config-0001-cfg0001_stand_2.0s_run_left_45_2.0s_stand_2.0s-81228c5c24f8"], "status": "completed", "started_unix": 1791646769.5418148, "returncode": 0, "evidence": {"path": "/outputs/reference629/random_locomotion/config-0001-cfg0001_stand_2.0s_run_left_45_2.0s_stand_2.0s-81228c5c24f8/case-evidence.json", "sha256": "6f56280e62cf47a88f397e967297057037d9bd614180c694d1bb69aaaee5ca6a", "bytes": 9945}, "wall_seconds": 18.249846182065085, "finished_unix": 1791646789.2023048, "log": {"path": "/outputs/reference629/logs/random_locomotion/config-0001/attempt-0001.log", "sha256": "b415eb3747764f843eb0c1b08d1a06a58f5e325bcaa3349264d01a6b156717db", "bytes": 60062}}, "sealed": true, "integrity_scope": "retained seal and files verified"}], "quality_verified": false, "obstacle_course_completion_verified": false, "reference_commands": true, "reference_frames": 300, "reference_fps": 50, "reference_motion": {"path": "/workspace/php_parkour/outputs/research/motion-matching/scenarios/random_locomotion/cfg0001_stand_2.0s_run_left_45_2.0s_stand_2.0s_motion.npz", "size": 557640, "sha256": "49f84349dc2c681af3833f9773b92d45995b0f6e1f9c7c6a19884beb2e7dc533"}, "command_runs": [{"start_frame": 0, "end_frame_exclusive": 100, "code": 0, "seconds": 2.0}, {"start_frame": 100, "end_frame_exclusive": 201, "code": 7, "seconds": 2.02}, {"start_frame": 201, "end_frame_exclusive": 300, "code": 0, "seconds": 1.98}], "reference_policy_seconds": 6.0, "reference_motion_sha256": "49f84349dc2c681af3833f9773b92d45995b0f6e1f9c7c6a19884beb2e7dc533", "reference_motion_path": "/workspace/php_parkour/outputs/research/motion-matching/scenarios/random_locomotion/cfg0001_stand_2.0s_run_left_45_2.0s_stand_2.0s_motion.npz", "policy_recording": "cases/random_locomotion/config-0001/attempt-0001/policy-recording/rollout_duration6.0s_motion.npz"}]</script><script>
const cases=JSON.parse(document.getElementById('case-data').textContent),search=document.getElementById('search'),scene=document.getElementById('scene'),state=document.getElementById('state');let page=0,selected=cases;const pageSize=24;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),num=v=>Number(v).toFixed(3);
function render(){const pages=Math.max(1,Math.ceil(selected.length/pageSize));page=Math.min(page,pages-1);document.getElementById('visible').textContent=selected.length+' / '+cases.length+' 配置';document.getElementById('page').textContent=(page+1)+' / '+pages;document.getElementById('previous').disabled=page===0;document.getElementById('next').disabled=page===pages-1;
document.getElementById('cards').innerHTML=selected.slice(page*pageSize,(page+1)*pageSize).map(r=>`<article data-case="${esc(r.case_id)}" data-state="${r.threshold_event?'threshold':'unflagged'}"><h2>${esc(r.scenario)} · ${r.configuration_index}</h2><span class="badge ${r.threshold_event?'threshold':''}">${r.threshold_event?'触发高度/倾斜阈值':'本次未触发阈值'}</span><p class="name small">${esc(r.configuration)}</p>${r.videos.map(v=>`<video controls preload="none" poster="${esc(v.thumbnail)}" src="${esc(v.path)}"></video><p class="small"><a href="${esc(v.path)}">原始MP4</a> · ${num(v.duration_seconds)}s · ${v.width}×${v.height}</p>`).join('')}<div class="facts"><span>${r.policy_ticks} ticks · ${num(r.policy_seconds)}s</span><span>${r.reference_commands?'reference 50 Hz · '+r.reference_frames+' frames':'command '+r.command} · seed42</span><span>最低pelvis ${num(r.minimum_pelvis_height_m)}m</span><span>最低up ${num(r.minimum_base_up_z)}</span><span>XY路径 ${num(r.path_length_xy_m)}m</span><span>末态up ${num(r.final_base_up_z)}</span></div>${r.reference_commands?`<details class="commands"><summary>50Hz reference逐段代码序列 (${r.command_runs.length}段)</summary><p class="small">source NPZ SHA ${esc(r.reference_motion.sha256)}；frame区间为[start,end)，时间从policy anchor开始，未重采样。</p><table><thead><tr><th>代码</th><th>帧[start,end)</th><th>起止秒</th><th>时长</th></tr></thead><tbody>${r.command_runs.map(run=>`<tr><td>${run.code}</td><td>[${run.start_frame}, ${run.end_frame_exclusive})</td><td>${num(run.start_frame/50)}–${num(run.end_frame_exclusive/50)}</td><td>${num(run.seconds)}s</td></tr>`).join('')}</tbody></table><a href="${esc(r.policy_recording)}">原生SDK策略录制NPZ（root XYZ为占位零，物理位置见CSV）</a></details>`:''}<details class="trajectory"><summary>实际世界XY轨迹与截图</summary><img loading="lazy" src="${esc(r.trajectory_svg)}" alt="Measured world XY trajectory">${r.videos.map(v=>`<a href="${esc(v.thumbnail)}"><img loading="lazy" src="${esc(v.thumbnail)}" alt="Original decoded thumbnail"></a>`).join('')}<a href="${esc(r.trajectory_csv)}">原始world XYZ/倾斜CSV</a></details><details><summary>SHA、原始结果和全部attempt</summary><p class="small">OBJ SHA ${esc(r.mesh_sha256)}。${r.attempts.length} 次attempt；失败记录未删除。${r.reference_commands?'按原生成reference代码逐帧控制；技能成功仍未验定。':'没有按reference技能序列控制。'}</p><p><a href="${esc(r.result_json)}">result JSON</a> · <a href="${esc(r.case_evidence)}">case-evidence</a> · <a href="${esc(r.attempts_json)}">全部attempt原始文件链接</a></p></details></article>`).join('');}
function filter(){const q=search.value.toLowerCase();selected=cases.filter(r=>(r.case_id+' '+r.configuration+' '+r.mesh_sha256).toLowerCase().includes(q)&&(scene.value==='all'||r.scenario===scene.value)&&(state.value==='all'||(r.threshold_event?'threshold':'unflagged')===state.value));page=0;render();}search.addEventListener('input',filter);scene.addEventListener('change',filter);state.addEventListener('change',filter);document.getElementById('previous').onclick=()=>{page--;render();};document.getElementById('next').onclick=()=>{page++;render();};filter();
</script></body></html>
