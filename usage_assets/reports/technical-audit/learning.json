  "ppo": {
    "gae": "delta=r+gamma*(1-done)*Vnext-V; A=delta+gamma*lambda*(1-done)*Anext; return=A+V",
    "advantage_normalization": "whole rollout (global moments when multiGPU enabled)",
    "surrogate": "mean(max(-A*ratio,-A*clip(ratio,.8,1.2)))",
    "value_loss": "mean(max((V-return)^2,(Vold+clip(V-Vold,-.2,.2)-return)^2)); no .5 factor",
    "actor_loss": "surrogate-.005*mean_entropy",
    "critic_loss": "value_loss",
    "symmetry_default_active": false,
    "timeout_bootstrap": "reward += gamma*V(final_obs)",
    "kl": "old Normal || new Normal, sum action dims",
    "kl_lr_rule": {
      "desired": 0.01,
      "high": 0.02,
      "low": 0.005,
      "factor": 1.5,
      "min": 1e-05,
      "max": 0.01
    }
  },
  "dagger": {
    "label": "online frozen teacher actor deterministic mean29 on student-visited state; not dataset q/dq or human labels",
    "teacher_detached": true,
    "teacher_order": "same ordered five registries and checkpoints",
    "routing": "current frame motion_idxs expertID; lost sets -1 => all-zero teacher action",
    "sampling": "uniform expert then uniform frame from explicit per-expert pools; variants may interleave",
    "buffer": "current rollout only; random permutation each epoch; clear after update",
    "pure": {
      "loss": "mean over batch and29 of (student_mean-teacher_action)^2",
      "lost_zero_labels_masked": false,
      "optimizer": "Adam student MLP+depth CNN only",
      "critic": false,
      "reward_in_loss": false,
      "std_optimized": false
    },
    "mixed": {
      "per_sample_bc": "d_n=1[teacher_action not all-zero]*mean29((student_mean-teacher_action)^2)",
      "masked_denominator": "full batch, not valid count",
      "scalar_ppo_ramp": "c_i=min(i/10000,.9); reaches .9 at i9000",
      "std_lr_and_kl_active_when": "c_i>.1 (i>1000 for fresh default run)",
      "loss": "Lvalue + mean(c_i*g_n*(surrogate_n-.001*entropy_n)) + mean((1-c_i*g_n)*10*d_n)",
      "critic_input_independent_of_depth": true,
      "value_loss_updates_depth": false,
      "gradients": {
        "value": [
          "critic"
        ],
        "ppo_actor": [
          "student_mlp",
          "depth_cnn",
          "std when LR active"
        ],
        "behavior": [
          "student_mlp",
          "depth_cnn"
        ],
        "teacher": [],
        "gate": []
      },
      "logged_behavior": "mean((1-c_i*g_n)*d_n), excludes coefficient10",
