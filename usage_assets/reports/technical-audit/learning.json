  "teacher_rewards": {
    "dt_multiplier": 0.02,
    "formula": "dt * sum(weight_j * raw_reward_j)",
    "terms": [
      {
        "name": "motion_global_ref_position_error_exp",
        "weight": 1,
        "sigma": 0.3,
        "formula": "exp(-L2(anchor_ref-anchor_robot)^2/sigma^2)"
      },
      {
        "name": "motion_global_ref_orientation_error_exp",
        "weight": 1,
        "sigma": 0.4,
        "formula": "exp(-quat_error_magnitude(anchor_ref,anchor_robot)^2/sigma^2)"
      },
      {
        "name": "motion_relative_body_position_error_exp",
        "weight": 1,
        "sigma": 0.3,
        "formula": "exp(-mean14(L2(yaw_aligned_ref_body-actual_body)^2)/sigma^2)"
      },
      {
        "name": "motion_relative_body_orientation_error_exp",
        "weight": 1,
        "sigma": 0.4,
        "formula": "exp(-mean14(quat_error_magnitude(yaw_aligned_ref_body,actual_body)^2)/sigma^2)"
      },
      {
        "name": "motion_global_body_lin_vel",
        "weight": 1,
        "sigma": 1,
        "formula": "exp(-mean14(L2(world_ref_linear_velocity-world_actual_linear_velocity)^2)/sigma^2)"
      },
      {
        "name": "motion_global_body_ang_vel",
        "weight": 1,
        "sigma": 3.14,
        "formula": "exp(-mean14(L2(world_ref_angular_velocity-world_actual_angular_velocity)^2)/sigma^2)"
      },
      {
        "name": "action_rate_l2",
        "weight": -0.1,
        "formula": "sum29((raw_action_t-raw_action_previous)^2)"
      },
      {
        "name": "limits_dof_pos",
        "weight": -10,
        "soft_limit_fraction": 0.9,
        "formula": "sum29(relu(soft_lower-q)+relu(q-soft_upper))"
      },
      {
        "name": "undesired_contacts",
        "weight": -0.5,
        "force_norm_threshold": 1,
        "physics_history_length": 3,
        "formula": "count selected bodies whose max_history force norm > threshold"
      }
    ],
    "no_explicit_joint_action_supervised_loss": true
  },
